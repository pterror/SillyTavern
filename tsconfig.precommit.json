{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "strict": false,
        "noEmit": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "skipLibCheck": true,
        "types": ["toastr", "node"],
        "paths": {
            "/*": ["./public/*"]
        }
    },
    "include": [
        "public/scripts/**/*.js",
        "src/**/*.js",
        "public/global.d.ts",
        "src/types/*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "backups",
        "data",
        "public/lib/**",
        "public/scripts/extensions/third-party/**",
        "public/scripts/extensions/tts/lib/**",
        "**/dist/**",
        "**/*.min.js"
    ]
}
