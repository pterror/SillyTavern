{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["import"],
    "ignorePatterns": [
        "**/node_modules/**",
        "**/dist/**",
        "**/.git/**",
        ".claude/**",
        "public/lib/**",
        "backups/**",
        "data/**",
        "cache/**",
        "src/tokenizers/**",
        "docker/**",
        "plugins/**",
        "**/*.min.js"
    ],
    "rules": {
        "import/no-cycle": "error"
    }
}
